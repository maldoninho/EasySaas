NODE_ENV=development
APP_NAME=EasySaaS
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_HOST=127.0.0.1
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://easysaas:easysaas@127.0.0.1:5432/easysaas
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-bytes
SETUP_TOKEN=replace-with-a-single-use-random-token
ENCRYPTION_KEY=replace-with-32-byte-base64-key
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL_HOURS=12
SINGLE_SESSION=true
PUBLIC_SIGNUP=false
LANDING_ENABLED=true
CAPTCHA_MODE=off
CAPTCHA_PROVIDER=off
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
SMTP_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EasySaaS <no-reply@example.local>
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=runtime/storage
MAX_UPLOAD_MB=25
MODULE_VALIDATION_TIMEOUT_MS=120000
MODULE_MAX_FILES=500
MODULE_MAX_EXTRACTED_MB=100
MODULE_ALLOW_NETWORK=false
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=info
TRUST_PROXY=false
